{
  "name": "rspack-vue3-template",
  "author": "xdsun777",
  "description": "A template for Rspack + Vue3",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "rspack",
    "vue3",
    "template"
  ],
  "scripts": {
    "test": "rspack serve --config=./config/rspack.base.config.mjs",
    "dev:serve": "rspack serve --mode=development --config=./config/rspack.dev.config.mjs",
    "dev:build": "rspack build --mode=development --config=./config/rspack.dev.config.mjs",
    "prod:serve": "rspack serve --mode=production --config=./config/rspack.prod.config.mjs",
    "prod:build": "set RSDOCTOR=true && set RSPACK_PROFILE=ALL && rspack build --mode=production --config=./config/rspack.prod.config.mjs"
  },
  "devDependencies": {
    "@rspack/cli": "^1.3.4",
    "@rspack/core": "^1.3.4",
    "vue": "^3.5.13",
    "vue-loader": "^17.4.2"
  }
}
